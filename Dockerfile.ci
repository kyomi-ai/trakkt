# ---------------------------------------------------------------------------
# Trakkt — self-contained CI Docker image (multi-stage build)
# ---------------------------------------------------------------------------
#
# Builds the entire Trakkt application from source inside Docker.
# Use this Dockerfile for CI pipelines where host toolchains are unavailable.
#
# How this differs from ./Dockerfile:
#   - Dockerfile      : packaging-only, expects pre-built artifacts on the host
#   - Dockerfile.ci   : compiles server binary + WASM frontend inside the build
#
# IMPORTANT: The server binary and WASM frontend are compiled in the SAME
# build stage from the SAME source tree. Leptos server_fn hashes include
# CARGO_MANIFEST_DIR — splitting the build across stages breaks the app.
#
# Usage:
#   docker build -f Dockerfile.ci -t trakkt:latest .
# ---------------------------------------------------------------------------

# ==========================================================================
# Stage 1: builder — compile server binary and WASM frontend
# ==========================================================================
FROM rust:1-bookworm AS builder

# System dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    pkg-config \
    libssl-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Rust WASM target
RUN rustup target add wasm32-unknown-unknown

# trunk v0.21.14
RUN wget -qO- https://github.com/trunk-rs/trunk/releases/download/v0.21.14/trunk-x86_64-unknown-linux-gnu.tar.gz \
    | tar -xzf - -C /usr/local/bin \
    && chmod +x /usr/local/bin/trunk

# wasm-bindgen-cli (must match the version in Cargo.lock)
RUN wget -qO- https://github.com/rustwasm/wasm-bindgen/releases/download/0.2.121/wasm-bindgen-0.2.121-x86_64-unknown-linux-musl.tar.gz \
    | tar -xzf - --strip-components=1 -C /usr/local/bin \
        wasm-bindgen-0.2.121-x86_64-unknown-linux-musl/wasm-bindgen

# tailwindcss v4.2.2
RUN wget -qO /usr/local/bin/tailwindcss \
    https://github.com/tailwindlabs/tailwindcss/releases/download/v4.2.2/tailwindcss-linux-x64 \
    && chmod +x /usr/local/bin/tailwindcss

# wasm-opt (binaryen) — installed to /opt so trunk doesn't find it on PATH
# (trunk auto-runs wasm-opt with just -O, which fails without --enable-bulk-memory-opt)
RUN wget -qO- https://github.com/WebAssembly/binaryen/releases/download/version_128/binaryen-version_128-x86_64-linux.tar.gz \
    | tar -xzf - --strip-components=2 -C /opt \
        binaryen-version_128/bin/wasm-opt

WORKDIR /build

# Copy full source tree
COPY . .

# Strip local dev patches from Cargo.toml (path overrides not available in Docker)
RUN sed -i '/# BEGIN_LOCAL_DEV_PATCHES/,/# END_LOCAL_DEV_PATCHES/{ /# BEGIN_LOCAL_DEV_PATCHES/!{ /# END_LOCAL_DEV_PATCHES/!d } }' Cargo.toml

# Strip cargo_profile and wasm-opt config so trunk uses the release profile
# without running its built-in wasm-opt (which doesn't pass --enable-bulk-memory-opt)
RUN sed -i '/cargo_profile/d; /^\[tools\]/d; /^wasm_opt/d' crates/trakkt-ui/Trunk.toml

# Build WASM frontend, then optimize with wasm-opt manually (with bulk-memory support)
RUN cd crates/trakkt-ui && trunk build --release \
    && for f in dist/*_bg.wasm; do \
         /opt/wasm-opt --enable-bulk-memory-opt -O -o "${f}.opt" "$f" && mv "${f}.opt" "$f"; \
       done

# Build server binary
RUN cargo build --release --bin trakkt

# ==========================================================================
# Stage 2: runtime — minimal image with just the binary and assets
# ==========================================================================
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/sh trakkt

WORKDIR /app

# Copy built artifacts from builder stage
COPY --from=builder /build/target/release/trakkt /app/trakkt
COPY --from=builder /build/crates/trakkt-ui/dist /app/dist

ENV PORT=8003 \
    TRUNK_DIST_DIR=/app/dist \
    RUST_LOG=info \
    HOME=/tmp \
    TMPDIR=/tmp

EXPOSE 8003

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/bin/sh", "-c", "wget -qO- http://localhost:8003/health || exit 1"]

USER trakkt

ENTRYPOINT ["/app/trakkt"]
